# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Anthropic — used by the pipeline (classify_*, build_rag_index, hustings) and
# the web /api/ask route (on-topic gate + answer synthesis).
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embeddings for the RAG chat/search index. Used by
# pipeline/build_rag_index.py and (at query time) the web /api/ask route.
VOYAGE_API_KEY=pa-...

# Pydantic Logfire — optional tracing for the pipeline + /api/ask. Leave blank
# to disable (everything is a no-op without a token).
LOGFIRE_TOKEN=

# --- Web /ask feature (set these on the web host, e.g. Render) ---
# Kill switch override. Unset = use the feature_flags.chat row in the DB
# (the instant, no-redeploy toggle). "true" forces ON, "false" force-disables.
CHAT_ENABLED=
# Secret salt for the one-way IP hash stored in chat_logs (use a long random value).
IP_HASH_SALT=

# Hugging Face — pyannote speaker diarisation (hustings audio pipeline only).
HF_TOKEN=

audio.m4a
video_metadata.json
youtube_captions.vtt

# faster-whisper output
words.json
transcript.txt

# pyannote output
diarised_segments.json
speaker_embeddings.npz

# Sandbox / experimental runs (e.g. sthelier-connetable-2026-auto/)
*-auto/

# Per-candidate voice fingerprint library — sensitive (uniquely identifies
# voices). Stays local.
_voice_embeddings/
